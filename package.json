    "@tanstack/router-plugin": "^1.166.3",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "supabase": "^2.81.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}