{
  "name": "twodo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "start": "supabase start",
    "update-types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:migration:new": "supabase migration new",
    "db:migration:push": "supabase db push --local --yes",
    "db:reset": "supabase db reset --local --yes",
    "db:sync": "supabase db dump --data-only -s public -f supabase/seed.sql && npm run db:reset"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@supabase/supabase-js": "2.101.0",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/query-async-storage-persister": "5.95.2",
    "@tanstack/react-query": "5.95.2",
    "@tanstack/react-query-persist-client": "5.95.2",
    "@tanstack/react-router": "1.168.10",
    "@vitejs/plugin-react": "6.0.1",
    "class-variance-authority": "0.7.1",
    "date-fns": "4.1.0",
    "i18next": "26.0.3",
    "i18next-browser-languagedetector": "8.2.1",
    "idb-keyval": "6.2.2",
    "lucide-react": "1.14.0",
    "motion": "12.38.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-error-boundary": "6.1.1",
    "react-hook-form": "7.72.0",
    "react-i18next": "17.0.2",
    "sonner": "2.0.7",
    "vite": "8.0.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "1.167.12",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.27",
    "supabase": "2.84.5",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vite": "8.0.3"
  }
}
