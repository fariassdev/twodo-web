    "db:sync": "supabase db dump --data-only -s public -f supabase/seed.sql && npm run db:reset"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.98.0",
    "@tailwindcss/vite": "^4.1.14",
